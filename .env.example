# Required: Anthropic API key for the DJ chat interface
ANTHROPIC_API_KEY=sk-ant-...

# Recommended: Last.fm API key for smart music discovery
# Get one free at https://www.last.fm/api/account/create
LASTFM_API_KEY=

# Optional: Override defaults
# AGENT_DJ_DB=tracks.db
# AGENT_DJ_AUDIO_DIR=samples
